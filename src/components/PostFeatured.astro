---
import type { Post } from '../lib/supabase';

interface Props {
  post: Post;
}

const { post } = Astro.props;

const dateStr = new Date(post.published_at).toLocaleDateString('es-AR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const astroBase = (import.meta.env.BASE_URL || '/').replace(/\/$/, '') + '/';
const link = `${astroBase}post/${post.slug}`;
const excerpt = post.excerpt || (post.content ? post.content.slice(0, 200) + '...' : '');
---

<article class="post-featured">
  {post.featured_image ? (
    <div class="featured-image-wrap">
      <img src={post.featured_image} alt={post.title} loading="lazy" />
      <span class="edge-glow"></span>
    </div>
  ) : (
    <div class="featured-image-wrap">
      <span class="edge-glow"></span>
    </div>
  )}
  <div class="featured-body">
    <span class={`post-badge badge-${post.badge_color || 'purple'}`}>{post.badge || 'Destacado'}</span>
    <h2><a href={link}>{post.title}</a></h2>
    <div class="post-meta">
      <span>{dateStr}</span>
      <span class="dot-sep"></span>
      <span>Mozz</span>
    </div>
    <p class="post-excerpt">{excerpt}</p>
    <a href={link} class="read-more">
      Leer más <span class="arrow">→</span>
    </a>
  </div>
</article>

<style>
  .featured-body h2 a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .featured-body h2 a:hover {
    color: var(--neon-purple);
  }
</style>
