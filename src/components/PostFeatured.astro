---
import type { Post } from '../lib/supabase';

interface Props {
  post: Post;
}

const { post } = Astro.props;

const dateStr = new Date(post.published_at).toLocaleDateString('es-AR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const astroBase = (import.meta.env.BASE_URL || '/').replace(/\/$/, '') + '/';
const link = `${astroBase}post/${post.slug}`;
const stripHTML = (html: string) => html.replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').trim();
const excerpt = post.excerpt || (post.content ? stripHTML(post.content).slice(0, 200) + '...' : '');
---

<a href={link} class="post-featured-link">
  <article class="post-featured">
    {post.featured_image ? (
      <div class="featured-image-wrap has-image">
        <img src={post.featured_image} alt={post.title} loading="lazy" />
        <span class="edge-glow"></span>
      </div>
    ) : (
      <div class="featured-image-wrap">
        <span class="edge-glow"></span>
      </div>
    )}
    <div class="featured-body">
      <span class={`post-badge badge-${post.badge_color || 'purple'}`}>{post.badge || 'Destacado'}</span>
      <h2>{post.title}</h2>
      <div class="post-meta">
        <span>{dateStr}</span>
        <span class="dot-sep"></span>
        <span>Mozz</span>
      </div>
      <p class="post-excerpt">{excerpt}</p>
      <span class="read-more">
        Leer más <span class="arrow">→</span>
      </span>
    </div>
  </article>
</a>

<style>
  .post-featured-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .post-featured-link:hover .post-featured {
    border-color: var(--neon-purple);
    box-shadow: 0 0 20px rgba(168, 85, 247, 0.1);
  }

  .post-featured-link:hover h2 {
    color: var(--neon-purple);
  }

  .post-featured {
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .featured-body h2 {
    color: var(--text-primary);
    transition: color 0.2s ease;
  }
</style>
