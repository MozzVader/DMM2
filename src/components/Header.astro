---
import { BASE_URL } from '../lib/constants';
import SideNav from './SideNav.astro';
---

<header class="mag-header">
  <div class="container">
    <div class="header-left">
      <div class="logo-area">
        <a href={BASE_URL}>
          <div class="logo-placeholder" title="Logo">
            <img src={`${BASE_URL}logo.png`} alt="Dos Minutos Más" />
          </div>
        </a>
      </div>
      <div class="title-area">
        <a href={BASE_URL} class="mag-title-link">
          <div class="mag-title-wrapper">
            <h1 class="mag-title">Dos Minutos Más</h1>
          </div>
        </a>
      </div>
    </div>

    <div class="search-area">
      <div class="search-box">
        <input type="text" id="searchInput" placeholder="Buscar..." aria-label="Buscar posts" autocomplete="off">
        <div class="search-results" id="searchResults"></div>
      </div>
    </div>

    <div class="toggle-area">
      <div class="toggle-track" id="themeToggle" role="switch" tabindex="0" aria-label="Cambiar a tema claro" aria-checked="false">
        <div class="toggle-thumb">
          <span class="toggle-icon-moon" aria-hidden="true">&#9790;</span>
          <span class="toggle-icon-sun" aria-hidden="true">&#9728;</span>
        </div>
      </div>
    </div>
  </div>
</header>

<SideNav />

<script is:inline>
(function() {
  const input = document.getElementById('searchInput');
  const results = document.getElementById('searchResults');
  if (!input || !results) return;

  let index = null;
  let baseUrl = '/';

  const nav = document.querySelector('.side-nav');
  if (nav && nav.dataset.baseUrl) baseUrl = nav.dataset.baseUrl;

  function stripHtml(html) {
    const div = document.createElement('div');
    div.innerHTML = html;
    return div.textContent || '';
  }

  function parseRss(xml) {
    const doc = new DOMParser().parseFromString(xml, 'text/xml');
    const items = doc.querySelectorAll('item');
    return Array.from(items).map(item => {
      const link = (item.querySelector('link')?.textContent || '').trim();
      // Extract slug from URL like .../post/my-slug
      const slug = link.split('/post/')[1] || '';
      const title = (item.querySelector('title')?.textContent || '').trim();
      const desc = (item.querySelector('description')?.textContent || '').trim();
      // content:encoded has namespace, need getElementsByTagNameNS or fallback
      const contentEl = item.getElementsByTagNameNS('*', 'encoded')[0]
        || item.querySelector('content\\:encoded')
        || item.querySelector('encoded');
      const contentHtml = contentEl ? (contentEl.textContent || '') : '';
      const fullText = stripHtml((title + ' ' + desc + ' ' + contentHtml).toLowerCase());
      const pubDate = item.querySelector('pubDate')?.textContent || '';
      return { title, slug, link, desc: stripHtml(desc), fullText, pubDate };
    });
  }

  async function loadIndex() {
    if (index) return index;
    try {
      const resp = await fetch(baseUrl + 'rss.xml');
      const xml = await resp.text();
      index = parseRss(xml);
    } catch(e) { index = []; }
    return index;
  }

  function formatDate(d) {
    const dt = new Date(d);
    if (isNaN(dt)) return '';
    const months = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
    return dt.getDate() + ' ' + months[dt.getMonth()] + ', ' + dt.getFullYear();
  }

  function escapeHtml(s) {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  function highlightContext(text, terms, maxLen) {
    // Find the best snippet containing the first matched term
    const lower = text.toLowerCase();
    let bestIdx = -1;
    for (const t of terms) {
      const idx = lower.indexOf(t);
      if (idx !== -1) { bestIdx = idx; break; }
    }
    let snippet;
    if (bestIdx >= 0) {
      const start = Math.max(0, bestIdx - 40);
      const end = Math.min(text.length, bestIdx + maxLen);
      snippet = (start > 0 ? '...' : '') + text.slice(start, end) + (end < text.length ? '...' : '');
    } else {
      snippet = text.slice(0, maxLen) + '...';
    }
    // Highlight matched terms
    let highlighted = escapeHtml(snippet);
    for (const t of terms) {
      const re = new RegExp('(' + t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
      highlighted = highlighted.replace(re, '<mark>$1</mark>');
    }
    return highlighted;
  }

  function renderResults(items, terms) {
    if (items.length === 0) {
      results.innerHTML = '<div class="sr-empty">Sin resultados</div>';
      results.classList.add('open');
      return;
    }
    const html = items.slice(0, 8).map(p => {
      const date = formatDate(p.pubDate);
      const context = highlightContext(p.fullText, terms, 120);
      return '<a href="' + escapeHtml(p.link) + '" class="sr-item">'
        + '<div class="sr-item-body">'
        + '<div class="sr-item-title">' + escapeHtml(p.title) + '</div>'
        + '<div class="sr-item-excerpt">' + context + '</div>'
        + (date ? '<div class="sr-item-meta">' + date + '</div>' : '')
        + '</div></a>';
    }).join('');
    results.innerHTML = html;
    results.classList.add('open');
  }

  function hide() { results.classList.remove('open'); results.innerHTML = ''; }

  function search(q) {
    if (!q || q.length < 2) { hide(); return; }
    const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
    if (terms.length === 0) { hide(); return; }
    const scored = (index || []).map(p => {
      const titleLower = p.title.toLowerCase();
      let score = 0;
      for (const t of terms) {
        if (titleLower.includes(t)) score += 10;
        if (p.fullText.includes(t)) score += 2;
      }
      return { ...p, score };
    }).filter(p => p.score > 0).sort((a, b) => b.score - a.score);
    renderResults(scored, terms);
  }

  let debounce;
  input.addEventListener('input', () => {
    clearTimeout(debounce);
    const q = input.value.trim();
    if (q.length < 2) { hide(); return; }
    debounce = setTimeout(async () => {
      await loadIndex();
      search(q);
    }, 200);
  });

  input.addEventListener('focus', async () => {
    await loadIndex();
    const q = input.value.trim();
    if (q.length >= 2) search(q);
  });

  document.addEventListener('click', (e) => {
    if (!e.target.closest('.search-box')) hide();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') hide();
  });
})();
</script>

<style>
  .mag-title-link {
    text-decoration: none;
  }
</style>

<style is:global>
  .search-results {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    background: var(--bg-card, #1a1a22);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.5);
    max-height: 420px;
    overflow-y: auto;
    z-index: 200;
  }

  .search-results.open {
    display: block;
  }

  .sr-empty {
    padding: 20px;
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-family: 'Inter', sans-serif;
  }

  .sr-item {
    display: block;
    padding: 12px 16px;
    text-decoration: none;
    border-bottom: 1px solid var(--border-subtle);
    transition: background 0.15s ease;
  }

  .sr-item:last-child { border-bottom: none; }

  .sr-item:hover {
    background: rgba(255,255,255,0.04);
  }

  body.light .sr-item:hover {
    background: rgba(0,0,0,0.04);
  }

  .sr-item-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .sr-item-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .sr-item-excerpt {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .sr-item-meta {
    font-size: 0.72rem;
    color: var(--text-secondary);
    opacity: 0.7;
    margin-top: 2px;
  }

  .sr-item .post-badge {
    align-self: flex-start;
    font-size: 0.65rem;
    padding: 1px 8px;
    line-height: 1.6;
  }

  .sr-item-excerpt mark {
    background: rgba(191, 90, 242, 0.25);
    color: var(--text-primary);
    border-radius: 2px;
    padding: 0 2px;
  }

  @media (max-width: 768px) {
    .search-results {
      position: fixed;
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      max-height: 60vh;
      border-radius: 12px 12px 0 0;
      z-index: 300;
    }
  }
</style>