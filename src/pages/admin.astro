---
// Admin CMS page — rendered as Astro page to guarantee it's in the build output
// All logic is client-side (Supabase Auth, Quill editor, image upload)
import '../styles/admin.css';

const adminJs = import.meta.env.PROD ? 'admin.min.js' : 'admin.js';
---

<!DOCTYPE html>
<html lang="es" data-sb-url={import.meta.env.SUPABASE_URL || ''} data-sb-key={import.meta.env.SUPABASE_ANON_KEY || ''} data-base-url={import.meta.env.BASE_URL || '/'}>
<head>
  <meta charset="UTF-8" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin — Dos Minutos Más</title>
  <link rel="icon" type="image/svg+xml" href={(import.meta.env.BASE_URL || '/').replace(/\/$/, '') + '/favicon.svg'} />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">
  <script is:inline src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/@enzedonline/quill-blot-formatter2@3.2.0/dist/index.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body>

  <!-- LOGIN -->
  <div class="login-screen" id="loginScreen">
    <div class="login-card">
      <h1>Dos Minutos Más</h1>
      <p>Panel de administración</p>
      <form id="loginForm">
        <div class="form-group">
          <label>Email</label>
          <input type="email" id="loginEmail" required autocomplete="email" />
        </div>
        <div class="form-group">
          <label>Contraseña</label>
          <input type="password" id="loginPassword" required autocomplete="current-password" />
        </div>
        <button type="submit" class="btn btn-primary btn-block">Iniciar sesión</button>
      </form>
      <div class="login-error" id="loginError"></div>
    </div>
  </div>

  <!-- ADMIN -->
  <div class="admin-layout" id="adminLayout">
    <!-- SIDEBAR NAV -->
    <nav class="admin-sidebar" id="adminSidebar">
      <button class="sidebar-tab active" data-section="posts" title="Posts">
        <i class="material-icons">article</i>
        <span>Posts</span>
      </button>
      <button class="sidebar-tab" data-section="stats" title="Estadísticas">
        <i class="material-icons">bar_chart</i>
        <span>Estadísticas</span>
      </button>
      <button class="sidebar-tab" data-section="backup" title="Backup">
        <i class="material-icons">cloud_download</i>
        <span>Backup</span>
      </button>
    </nav>

    <header class="admin-header">
      <h1 class="admin-title">DMM Admin <span>Panel</span></h1>
      <div class="header-actions">
        <a href={Astro.url.origin + import.meta.env.BASE_URL} target="_blank" class="btn btn-sm">Ver blog →</a>
        <button class="btn btn-sm" id="logoutBtn">Salir</button>
      </div>
    </header>

    <div class="admin-content">
      <!-- DASHBOARD -->
      <div class="dashboard-screen" id="dashboardScreen">
        <div class="dashboard-header">
          <h3>Posts</h3>
          <button class="btn btn-primary" id="newPostBtn">+ Nuevo post</button>
        </div>
        <div class="filter-bar" id="filterBar">
          <button class="filter-btn active" data-filter="all">Todos</button>
          <button class="filter-btn" data-filter="published">Publicados</button>
          <button class="filter-btn" data-filter="draft">Borradores</button>
          <button class="filter-btn" data-filter="scheduled">Programados</button>
        </div>
        <table class="posts-table">
          <thead>
            <tr>
              <th>⭐</th>
              <th>Título</th>
              <th>Badge</th>
              <th>Fecha</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody id="postsTableBody">
            <tr><td colspan="5" style="text-align:center;padding:40px;color:var(--text-secondary);">Cargando posts...</td></tr>
          </tbody>
        </table>
        <div class="pagination" id="pagination"></div>
      </div>

      <!-- STATS DASHBOARD -->
      <div class="stats-screen hidden" id="statsScreen">
        <div class="stats-kpi-row">
          <div class="kpi-card">
            <div class="kpi-dual">
              <div>
                <div class="kpi-value" id="kpiTotalPosts">—</div>
                <div class="kpi-label">Posts</div>
              </div>
              <div class="kpi-divider"></div>
              <div>
                <div class="kpi-value" id="kpiTotalLikes">—</div>
                <div class="kpi-label">Likes</div>
              </div>
            </div>
            <div class="kpi-sub" id="kpiRatio">— likes/post</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpiLastPost">—</div>
            <div class="kpi-label">Último Post</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpiAvgWords">—</div>
            <div class="kpi-label">Words Prom.</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpiCadencia">—</div>
            <div class="kpi-label">Cadencia</div>
            <div class="kpi-sub">días entre posts</div>
          </div>
        </div>
        <div class="stats-charts-row">
          <div class="chart-card">
            <h4>Posts por Mes</h4>
            <canvas id="chartMonthlyPosts"></canvas>
          </div>
          <div class="chart-card">
            <h4>Likes por Mes</h4>
            <canvas id="chartMonthlyLikes"></canvas>
          </div>
        </div>
        <div class="stats-charts-row">
          <div class="chart-card">
            <h4>Tags</h4>
            <div class="chart-doughnut-wrap">
              <canvas id="chartCategories"></canvas>
            </div>
          </div>
          <div class="chart-card">
            <h4>Tag / Likes (promedio)</h4>
            <div id="tagLikesTable" class="tag-likes-container">
              <p style="color:var(--text-muted);">Cargando...</p>
            </div>
          </div>
        </div>
        <div class="stats-section">
          <h4 class="stats-section-title">Top 5 Posts por Likes</h4>
          <table class="stats-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Post</th>
                <th>Likes</th>
                <th>Fecha</th>
              </tr>
            </thead>
            <tbody id="topPostsBody">
              <tr><td colspan="4" style="text-align:center;color:var(--text-muted);padding:20px;">Cargando...</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- EDITOR -->
      <div class="editor-screen" id="editorScreen">
        <div class="editor-header">
          <button class="btn btn-sm" id="backBtn">← Volver</button>
          <h3 id="editorTitle" style="font-family:'Space Grotesk',sans-serif;">Nuevo post</h3>
        </div>

        <div class="editor-grid">
          <!-- Title + Slug -->
          <div class="editor-section full-width">
            <div class="form-group">
              <label>Título</label>
              <input type="text" id="postTitle" placeholder="Título del post" />
            </div>
            <div class="form-group">
              <label>Slug</label>
              <input type="text" id="postSlug" placeholder="auto-generado-desde-el-titulo" />
            </div>
          </div>

          <!-- Meta -->
          <div class="editor-section">
            <h4>Metadatos</h4>
            <div class="form-group">
              <label>Badge</label>
              <select id="postBadge">
                <option value="General">General</option>
                <option value="Opinión">Opinión</option>
                <option value="Destacado">Destacado</option>
                <option value="Humor">Humor</option>
                <option value="Reflexión">Reflexión</option>
                <option value="Tutorial">Tutorial</option>
                <option value="Museo">Museo</option>
                <option value="Noticias">Noticias</option>
                <option value="Inteligencia Artificial">Inteligencia Artificial</option>
              </select>
            </div>
            <div class="form-group">
              <label>Color del badge</label>
              <select id="postBadgeColor">
                <option value="purple">Morado</option>
                <option value="red">Rojo</option>
                <option value="yellow">Amarillo</option>
                <option value="green">Verde</option>
                <option value="cyan">Cyan</option>
              </select>
            </div>
            <div class="form-group">
              <div class="toggle-row">
                <div class="toggle-switch" id="toggleFeatured"></div>
                <span style="font-size:0.85rem;">Post destacado</span>
              </div>
            </div>
            <div class="form-group">
              <label>Fecha de publicación</label>
              <input type="datetime-local" id="postDate" />
              <small style="color:var(--text-muted);font-size:0.75rem;margin-top:4px;display:block;">Dejar vacío = ahora. Podés poner fechas pasadas o futuras.</small>
            </div>
          </div>

          <!-- Featured Image -->
          <div class="editor-section">
            <h4>Imagen destacada</h4>
            <small style="color:var(--text-muted);font-size:0.7rem;line-height:1.5;display:block;margin-bottom:10px;">
              Tamaños recomendados:<br>
              • <strong>Featured:</strong> 1200×420 (aspecto ~16:7)<br>
              • <strong>Standard:</strong> 680×520 (aspecto ~4:3)
            </small>
            <div class="image-url-row">
              <input type="text" id="postImageUrl" placeholder="URL de imagen externa" />
              <button class="btn btn-sm" id="setImageBtn">Usar</button>
            </div>
            <div class="upload-area" id="uploadArea">
              <p>📷 Hacé click o arrastrá una imagen para subirla</p>
            </div>
            <input type="file" id="imageUpload" accept="image/*" style="display:none;" />
            <div class="upload-preview" id="uploadPreview"></div>
            <button class="btn btn-sm btn-danger" id="removeImageBtn" style="margin-top:8px;display:none;">Eliminar imagen</button>
          </div>

          <!-- Tags -->
          <div class="editor-section full-width">
            <h4>Tags del post</h4>
            <div class="tags-selector" id="tagsSelector"></div>
          </div>

          <!-- Tags Manager -->
          <div class="editor-section full-width">
            <h4>Crear / eliminar tags</h4>
            <div class="tags-manager-row">
              <input type="text" id="newTagName" placeholder="Nombre del nuevo tag" />
              <button class="btn btn-primary" id="addTagBtn">Agregar</button>
            </div>
            <div class="tags-list" id="tagsList"></div>
          </div>

          <!-- Excerpt -->
          <div class="editor-section full-width">
            <h4>Extracto</h4>
            <div class="form-group">
              <textarea id="postExcerpt" placeholder="Breve descripción del post (opcional — se genera automáticamente si lo dejás vacío)" rows="3"></textarea>
            </div>
          </div>

          <!-- Content -->
          <div class="editor-section full-width" style="height:542px;overflow:hidden;display:flex;flex-direction:column;">
            <div class="editor-section-header">
              <h4>Contenido</h4>
              <button class="btn btn-sm html-toggle-btn" id="htmlToggleBtn">HTML</button>
            </div>
            <div id="editor-container" style="flex:1;overflow:visible;"></div>
            <textarea id="htmlEditor" class="html-editor" style="display:none;flex:1;resize:none;"></textarea>
          </div>

          <!-- Actions -->
          <div class="editor-actions full-width">
            <button class="btn btn-primary" id="savePostBtn">Guardar post</button>
            <button class="btn" id="saveDraftBtn" style="margin-left:4px;">Guardar borrador</button>
            <button class="btn" id="previewBtn" style="margin-left:4px;">👁 Vista previa</button>
            <button class="btn" id="cancelBtn">Cancelar</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Delete confirmation -->
  <div class="confirm-overlay" id="confirmOverlay">
    <div class="confirm-card">
      <p id="confirmMsg">¿Estás seguro?</p>
      <div class="confirm-actions">
        <button class="btn" id="confirmCancel">Cancelar</button>
        <button class="btn btn-danger" id="confirmOk">Eliminar</button>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <div class="toast" id="toast"></div>

  <!-- URL Input Modal for Quill image insert -->
  <div class="img-url-modal-overlay" id="imgUrlModalOverlay">
    <div class="img-url-modal">
      <h4>Insertar imagen por URL</h4>
      <input type="text" id="imgUrlInput" placeholder="https://ejemplo.com/imagen.jpg" />
      <div class="img-url-modal-actions">
        <button class="btn btn-sm" id="imgUrlCancel">Cancelar</button>
        <button class="btn btn-sm btn-primary" id="imgUrlInsert">Insertar</button>
      </div>
    </div>
  </div>

  <!-- Preview Modal -->
  <div class="preview-modal-overlay" id="previewOverlay">
    <div class="preview-modal">
      <div class="preview-modal-header">
        <h3>Vista previa del post</h3>
        <button class="preview-modal-close" id="previewClose">×</button>
      </div>
      <div class="preview-modal-body" id="previewBody"></div>
    </div>
  </div>

  <!-- BACKUP SCREEN -->
  <div class="dashboard-screen hidden" id="backupScreen">
    <div class="dashboard-header">
      <h3>Backup de datos</h3>
    </div>
    <div class="backup-grid">
      <!-- Export -->
      <div class="backup-card">
        <div class="backup-card-icon">📤</div>
        <h4>Exportar base de datos</h4>
        <p>Descarga todos los posts, tags y relaciones en un archivo JSON.</p>
        <button class="btn btn-primary" id="exportBtn">Descargar backup</button>
        <p class="backup-hint" id="exportInfo"></p>
      </div>
      <!-- Import -->
      <div class="backup-card">
        <div class="backup-card-icon">📥</div>
        <h4>Importar base de datos</h4>
        <p>Restaura datos desde un archivo JSON de backup previo.</p>
        <input type="file" id="importFile" accept=".json" style="display:none;" />
        <button class="btn" id="importBtn" style="background:var(--neon-yellow);color:#000;">Seleccionar archivo</button>
        <div id="importPreview" style="display:none;margin-top:12px;">
          <p id="importSummary" style="font-size:0.85rem;color:var(--text-secondary);margin-bottom:10px;"></p>
          <label style="display:flex;align-items:center;gap:6px;font-size:0.8rem;color:var(--neon-red);cursor:pointer;margin-bottom:10px;">
            <input type="checkbox" id="importConfirmReplace" /> <span>Entiendo que esto va a <b>reemplazar</b> todos los posts y tags existentes</span>
          </label>
          <button class="btn btn-danger" id="importExecBtn" disabled>⚠️ Restaurar backup</button>
        </div>
      </div>
    </div>
  </div>

  <!-- FAB -->
  <div class="fab-container" id="fabContainer">
    <div class="fab-label">Herramientas</div>
    <button class="fab-main" id="fabMain" title="Herramientas externas">+</button>
    <div class="fab-menu" id="fabMenu">
      <button class="fab-menu-item" id="fabMuseum" title="Copiar placa Museo al portapapeles">
        <span class="fab-icon">🏛</span> Placa Museo
      </button>
      <button class="fab-menu-item" id="fabTimeline" title="Copiar Timeline al portapapeles">
        <span class="fab-icon">📅</span> Timeline
      </button>
      <button class="fab-menu-item" id="fabSeparator" title="Copiar separador gradient al portapapeles">
        <span class="fab-icon">✨</span> Separador
      </button>
      <button class="fab-menu-item" id="fabTable" title="Copiar tabla al portapapeles">
        <span class="fab-icon">📊</span> Tabla
      </button>
      <a href="https://iloveimg.com" target="_blank" rel="noopener" class="fab-menu-item">
        <span class="fab-icon">🖼</span> iLoveIMG (comprimir/redimensionar)
      </a>
      <a href="https://postimages.org" target="_blank" rel="noopener" class="fab-menu-item">
        <span class="fab-icon">📸</span> PostImages (hosting gratuito)
      </a>
    </div>
  </div>

<script is:inline src={(import.meta.env.BASE_URL || '/').replace(/\/$/, '') + '/' + adminJs}></script>
</body>
</html>
