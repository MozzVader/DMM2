---
import type { Post } from '../lib/supabase';
import { BASE_URL } from '../lib/constants';
import { formatDate } from '../lib/utils';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;

const colors = ['purple', 'red', 'yellow', 'green'] as const;
---

<div class="mini-posts">
  {posts.map((post, i) => (
    <a href={`${BASE_URL}post/${post.slug}`} class="mini-post-item">
      <span class={`mini-dot ${colors[i % colors.length]}`}></span>
      <span class="mini-post-title">{post.title}</span>
      <span class="mini-post-date">
        {formatDate(post.published_at, { day: 'numeric', month: 'short', year: 'numeric' })}
      </span>
    </a>
  ))}
</div>

<style>
  .mini-posts a {
    text-decoration: none;
  }
</style>