---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionDivider from '../components/SectionDivider.astro';
import PostFeatured from '../components/PostFeatured.astro';
import PostStandard from '../components/PostStandard.astro';
import MiniPosts from '../components/MiniPosts.astro';
import BottomGrid from '../components/BottomGrid.astro';
import {
  getFeaturedPost,
  getAllPosts,
} from '../lib/supabase';
import { BASE_URL } from '../lib/constants';

const featured = await getFeaturedPost();
const allPosts = await getAllPosts();

// Next 3 posts as horizontal cards
const standardPosts = allPosts.slice(0, 3);

// Remaining posts for the mini list
const miniPosts = allPosts.slice(3, 8);
---

<BaseLayout title="Dos Minutos Más">
  <Header slot="header" />

  <div class="container">

    <!-- Featured post -->
    {featured && <PostFeatured post={featured} />}

    <SectionDivider label="Más reciente" />

    <!-- Next 3 posts as horizontal cards -->
    {standardPosts.map((post) => (
      <PostStandard post={post} />
    ))}

    <SectionDivider label="Últimos posts" />

    <!-- Mini posts list -->
    {miniPosts.length > 0 && <MiniPosts posts={miniPosts} />}

    <div class="view-all-wrap">
      <a href={`${BASE_URL}posts`} class="view-all-btn">
        Ver todos los posts <span class="arrow">→</span>
      </a>
    </div>

    <SectionDivider label="Explorar" />

    <!-- Bottom grid -->
    <BottomGrid />

  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .view-all-wrap {
    text-align: center;
    margin: 32px 0 0;
  }

  .view-all-btn {
    display: inline-block;
    padding: 12px 32px;
    border: 1px solid var(--border-subtle);
    border-radius: 5px;
    text-decoration: none;
    color: var(--text-primary);
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    transition: all 0.2s ease;
    background: var(--bg-card);
  }

  .view-all-btn:hover {
    border-color: var(--neon-purple);
    color: var(--neon-purple);
  }

  .view-all-btn .arrow {
    margin-left: 4px;
  }
</style>