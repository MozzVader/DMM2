---
import type { Post } from '../lib/supabase';

interface Props {
  post: Post;
}

const { post } = Astro.props;

const dateStr = new Date(post.published_at).toLocaleDateString('es-AR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const astroBase = (import.meta.env.BASE_URL || '/').replace(/\/$/, '') + '/';
const link = `${astroBase}post/${post.slug}`;
const stripHTML = (html: string) => html.replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').trim();
const excerpt = post.excerpt || (post.content ? stripHTML(post.content).slice(0, 160) + '...' : '');
---

<a href={link} class="post-standard-link">
  <article class="post-standard">
    {post.featured_image ? (
      <div class="standard-image has-image" style={`background-image: url(${post.featured_image}); background-size: cover; background-position: center;`}></div>
    ) : (
      <div class="standard-image"></div>
    )}
    <div class="standard-body">
      <span class={`post-badge badge-${post.badge_color || 'red'}`}>{post.badge || 'General'}</span>
      <h3>{post.title}</h3>
      <div class="post-meta">
        <span>{dateStr}</span>
        <span class="dot-sep"></span>
        <span>Mozz</span>
      </div>
      <p class="post-excerpt">{excerpt}</p>
      <span class="read-more" style="margin-top: 8px;">
        Leer más <span class="arrow">→</span>
      </span>
    </div>
  </article>
</a>

<style>
  .post-standard-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .post-standard-link:hover .post-standard {
    border-color: var(--neon-purple);
    box-shadow: 0 0 20px rgba(168, 85, 247, 0.1);
  }

  .post-standard-link:hover h3 {
    color: var(--neon-purple);
  }

  .post-standard {
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .standard-body h3 {
    color: var(--text-primary);
    transition: color 0.2s ease;
  }
</style>
