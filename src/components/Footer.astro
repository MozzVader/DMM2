---
import { BASE_URL } from '../lib/constants';
---

<footer class="mag-footer">
  <p>Dos Minutos Más &copy; {new Date().getFullYear()} — Hecho con <span class="neon-word">humo</span> y mirrors. <a href="https://cafecito.app/mozz_vader" class="footer-link" target="_blank" rel="noopener" aria-label="Invitame un cafecito"><svg class="footer-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.083 5h10.834a1.08 1.08 0 0 1 1.083 1.077v8.615c0 2.38-1.94 4.308-4.333 4.308h-4.334c-2.393 0-4.333-1.929-4.333-4.308v-8.615a1.08 1.08 0 0 1 1.083-1.077"/><path d="M16 8h2.5c1.38 0 2.5 1.045 2.5 2.333v2.334c0 1.288-1.12 2.333-2.5 2.333h-2.5"/></svg></a><a href={`${BASE_URL}rss.xml`} class="footer-link" aria-label="Feed RSS"><svg class="footer-icon rss-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="6.18" cy="17.82" r="2.18" fill="#FF8C00"/><path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z" fill="#FF8C00"/></svg></a></p>
</footer>

<style>
  .footer-link {
    color: var(--text-secondary);
    text-decoration: none;
    margin-left: 8px;
    transition: color 0.2s ease;
    display: inline-flex;
    align-items: center;
  }
  .footer-link:hover {
    color: var(--neon-purple);
  }
  .footer-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  /* RSS keeps its orange color */
  .rss-icon circle,
  .rss-icon path {
    fill: #FF8C00;
  }
  .footer-link:hover .rss-icon circle,
  .footer-link:hover .rss-icon path {
    fill: var(--neon-purple);
  }
</style>