---
import { BASE_URL } from '../lib/constants';
import SideNav from './SideNav.astro';
---

<header class="mag-header">
  <div class="container">
    <div class="header-left">
      <div class="logo-area">
        <a href={BASE_URL}>
          <div class="logo-placeholder" title="Logo">
            <img src={`${BASE_URL}logo.png`} alt="Dos Minutos Más" />
          </div>
        </a>
      </div>
      <div class="title-area">
        <a href={BASE_URL} class="mag-title-link">
          <div class="mag-title-wrapper">
            <h1 class="mag-title">Dos Minutos Más</h1>
          </div>
        </a>
      </div>
    </div>

    <div class="search-area">
      <div class="search-box">
        <input type="text" id="searchInput" placeholder="Buscar..." aria-label="Buscar posts" autocomplete="off">
        <div class="search-results" id="searchResults"></div>
      </div>
    </div>

    <div class="toggle-area">
      <div class="toggle-track" id="themeToggle" role="switch" tabindex="0" aria-label="Cambiar a tema claro" aria-checked="false">
        <div class="toggle-thumb">
          <span class="toggle-icon-moon" aria-hidden="true">&#9790;</span>
          <span class="toggle-icon-sun" aria-hidden="true">&#9728;</span>
        </div>
      </div>
    </div>
  </div>
</header>

<SideNav />

<script is:inline>
(function() {
  const input = document.getElementById('searchInput');
  const results = document.getElementById('searchResults');
  if (!input || !results) return;

  let index = null;
  let baseUrl = '/';

  // Get base URL from the RSS <link> or og:url meta
  const nav = document.querySelector('.side-nav');
  if (nav && nav.dataset.baseUrl) baseUrl = nav.dataset.baseUrl;

  async function loadIndex() {
    if (index) return index;
    try {
      const resp = await fetch(baseUrl + 'search-index.json');
      index = await resp.json();
    } catch(e) { index = []; }
    return index;
  }

  const badgeColors = { purple: 'badge-purple', red: 'badge-red', yellow: 'badge-yellow', green: 'badge-green' };

  function formatDate(d) {
    const dt = new Date(d);
    const months = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
    return dt.getDate() + ' ' + months[dt.getMonth()] + ', ' + dt.getFullYear();
  }

  function escapeHtml(s) {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  function renderResults(items) {
    if (items.length === 0) {
      results.innerHTML = '<div class="sr-empty">Sin resultados</div>';
      results.classList.add('open');
      return;
    }
    const html = items.slice(0, 8).map(p => {
      const bc = badgeColors[p.bc] || 'badge-purple';
      const tags = p.g && p.g.length ? ' · ' + p.g.join(', ') : '';
      const excerpt = p.e.length > 120 ? p.e.slice(0, 120) + '...' : p.e;
      return '<a href="' + baseUrl + 'post/' + p.s + '" class="sr-item">'
        + '<div class="sr-item-body">'
        + '<span class="post-badge ' + bc + '">' + escapeHtml(p.b) + '</span>'
        + '<div class="sr-item-title">' + escapeHtml(p.t) + '</div>'
        + '<div class="sr-item-excerpt">' + escapeHtml(excerpt) + '</div>'
        + '<div class="sr-item-meta">' + formatDate(p.d) + tags + '</div>'
        + '</div></a>';
    }).join('');
    results.innerHTML = html;
    results.classList.add('open');
  }

  function hide() { results.classList.remove('open'); results.innerHTML = ''; }

  function search(q) {
    if (!q || q.length < 2) { hide(); return; }
    const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
    if (terms.length === 0) { hide(); return; }
    const scored = (index || []).map(p => {
      const title = (p.t || '').toLowerCase();
      const excerpt = (p.e || '').toLowerCase();
      const tags = (p.g || []).join(' ').toLowerCase();
      let score = 0;
      for (const t of terms) {
        if (title.includes(t)) score += 10;
        if (tags.includes(t)) score += 5;
        if (excerpt.includes(t)) score += 2;
      }
      return { ...p, score };
    }).filter(p => p.score > 0).sort((a, b) => b.score - a.score);
    renderResults(scored);
  }

  let debounce;
  input.addEventListener('input', () => {
    clearTimeout(debounce);
    const q = input.value.trim();
    if (q.length < 2) { hide(); return; }
    debounce = setTimeout(async () => {
      await loadIndex();
      search(q);
    }, 200);
  });

  input.addEventListener('focus', async () => {
    await loadIndex();
    const q = input.value.trim();
    if (q.length >= 2) search(q);
  });

  document.addEventListener('click', (e) => {
    if (!e.target.closest('.search-box')) hide();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') hide();
  });
})();
</script>

<style>
  .mag-title-link {
    text-decoration: none;
  }
</style>

<style is:global>
  .search-results {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    background: var(--bg-card, #1a1a22);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.5);
    max-height: 420px;
    overflow-y: auto;
    z-index: 200;
  }

  .search-results.open {
    display: block;
  }

  .sr-empty {
    padding: 20px;
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-family: 'Inter', sans-serif;
  }

  .sr-item {
    display: block;
    padding: 12px 16px;
    text-decoration: none;
    border-bottom: 1px solid var(--border-subtle);
    transition: background 0.15s ease;
  }

  .sr-item:last-child { border-bottom: none; }

  .sr-item:hover {
    background: rgba(255,255,255,0.04);
  }

  body.light .sr-item:hover {
    background: rgba(0,0,0,0.04);
  }

  .sr-item-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .sr-item-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .sr-item-excerpt {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .sr-item-meta {
    font-size: 0.72rem;
    color: var(--text-secondary);
    opacity: 0.7;
    margin-top: 2px;
  }

  .sr-item .post-badge {
    align-self: flex-start;
    font-size: 0.65rem;
    padding: 1px 8px;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .search-results {
      position: fixed;
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      max-height: 60vh;
      border-radius: 12px 12px 0 0;
      z-index: 300;
    }
  }
</style>