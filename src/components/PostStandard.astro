---
import type { Post } from '../lib/supabase';
import { BASE_URL, AUTHOR } from '../lib/constants';
import { stripHTML, formatDate, readingTime } from '../lib/utils';

interface Props {
  post: Post;
}

const { post } = Astro.props;

const dateStr = formatDate(post.published_at);
const link = `${BASE_URL}post/${post.slug}`;
const excerpt = post.excerpt || (post.content ? stripHTML(post.content).slice(0, 160) + '...' : '');
const mins = readingTime(post.content);
---

<a href={link} class="post-standard-link">
  <article class="post-standard">
    {post.featured_image ? (
      <div class="standard-image has-image" style={`background-image: url(${post.featured_image}); background-size: cover; background-position: center;`}></div>
    ) : (
      <div class="standard-image"></div>
    )}
    <div class="standard-body">
      <span class={`post-badge badge-${post.badge_color || 'red'}`}>{post.badge || 'General'}</span>
      <h3>{post.title}</h3>
      <div class="post-meta">
        <span class="meta-item"><svg class="meta-icon" aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>{dateStr}</span>
        <span class="dot-sep"></span>
        <span class="meta-item"><svg class="meta-icon" aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>{AUTHOR.name}</span>
        <span class="dot-sep"></span>
        <span class="meta-item"><svg class="meta-icon" aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>{mins} min</span>
      </div>
      <p class="post-excerpt">{excerpt}</p>
      <span class="read-more" style="margin-top: 8px;">
        Leer más <span class="arrow">→</span>
      </span>
    </div>
  </article>
</a>

<style>
  .post-standard-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .post-standard-link:hover .post-standard {
    border-color: var(--neon-purple);
    box-shadow: 0 0 20px rgba(168, 85, 247, 0.1);
  }

  .post-standard-link:hover h3 {
    color: var(--neon-purple);
  }

  .post-standard {
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .standard-body h3 {
    color: var(--text-primary);
    transition: color 0.2s ease;
  }
</style>