---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostStandard from '../../components/PostStandard.astro';
import BottomGrid from '../../components/BottomGrid.astro';
import { getAllPostsForPagination } from '../../lib/supabase';
import type { Post } from '../../lib/supabase';
import { BASE_URL } from '../../lib/constants';

export async function getStaticPaths({ paginate }: { paginate: (items: Post[], opts: { pageSize: number }) => any }) {
  const allPosts = await getAllPostsForPagination();
  return paginate(allPosts, { pageSize: 10 });
}

const { page } = Astro.props;

/** Generate truncated page numbers: 1 ... 4 5 [6] 7 8 ... 20 */
function getPageNumbers(current: number, total: number): (number | '...')[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);

  const pages: (number | '...')[] = [1];

  if (current > 3) pages.push('...');

  const start = Math.max(2, current - 1);
  const end = Math.min(total - 1, current + 1);

  for (let i = start; i <= end; i++) pages.push(i);

  if (current < total - 2) pages.push('...');

  pages.push(total);
  return pages;
}

const pageNumbers = getPageNumbers(page.currentPage, page.lastPage);
---

<BaseLayout title={page.currentPage === 1 ? 'Todos los posts — Dos Minutos Más' : `Página ${page.currentPage} — Dos Minutos Más`}>
  <Header slot="header" />

  <div class="container">
    <div class="posts-header">
      <h1>Todos los posts</h1>
      <p>Página {page.currentPage} de {page.lastPage}</p>
    </div>

    {page.data.map((post: Post) => (
      <PostStandard post={post} />
    ))}

    {page.data.length === 0 && (
      <div class="empty-state">
        <p>No hay posts todavía.</p>
      </div>
    )}

    <!-- Pagination (truncated) -->
    {page.lastPage > 1 && (
      <nav class="pagination" aria-label="Paginación">
        <a
          href={page.url.prev || '#'}
          class={`page-btn page-prev ${!page.url.prev ? 'disabled' : ''}`}
          aria-disabled={!page.url.prev}
        >
          ← Anterior
        </a>

        <div class="page-numbers">
          {pageNumbers.map((num) => {
            if (num === '...') return <span class="page-ellipsis">...</span>;
            const href = num === 1 ? `${BASE_URL}posts` : `${BASE_URL}posts/${num}`;
            return (
              <a href={href} class={`page-num ${num === page.currentPage ? 'active' : ''}`} aria-current={num === page.currentPage ? 'page' : undefined}>
                {num}
              </a>
            );
          })}
        </div>

        <a
          href={page.url.next || '#'}
          class={`page-btn page-next ${!page.url.next ? 'disabled' : ''}`}
          aria-disabled={!page.url.next}
        >
          Siguiente →
        </a>
      </nav>
    )}

    <BottomGrid />
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .posts-header {
    margin-bottom: 32px;
  }

  .posts-header h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 2rem;
    background: linear-gradient(135deg, var(--neon-purple), var(--neon-red));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 8px;
  }

  .posts-header p {
    color: var(--text-secondary);
    font-size: 0.85rem;
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin: 40px 0 48px;
    flex-wrap: wrap;
  }

  .page-btn {
    padding: 8px 20px;
    border: 1px solid var(--border-subtle);
    border-radius: 5px;
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-family: 'Inter', sans-serif;
    transition: all 0.2s ease;
    background: var(--bg-card);
  }

  .page-btn:hover:not(.disabled) {
    border-color: var(--neon-purple);
    color: var(--neon-purple);
  }

  .page-btn.disabled {
    opacity: 0.3;
    pointer-events: none;
    cursor: default;
  }

  .page-numbers {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .page-num {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-subtle);
    border-radius: 5px;
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-family: 'Inter', sans-serif;
    transition: all 0.2s ease;
    background: var(--bg-card);
  }

  .page-num:hover {
    border-color: var(--neon-purple);
    color: var(--neon-purple);
  }

  .page-num.active {
    border-color: var(--neon-purple);
    background: rgba(191, 90, 242, 0.1);
    color: var(--neon-purple);
    font-weight: 600;
  }

  .page-ellipsis {
    color: var(--text-muted);
    font-size: 0.85rem;
    padding: 0 4px;
  }

  @media (max-width: 480px) {
    .pagination {
      gap: 8px;
    }

    .page-btn {
      padding: 6px 14px;
      font-size: 0.8rem;
    }
  }
</style>