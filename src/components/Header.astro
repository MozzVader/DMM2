---
import { BASE_URL } from '../lib/constants';
---

<header class="mag-header">
  <div class="container">
    <div class="header-left">
      <div class="logo-area">
        <a href={BASE_URL}>
          <div class="logo-placeholder" title="Logo">
            <img src={`${BASE_URL}logo.png`} alt="Dos Minutos Más" />
          </div>
        </a>
      </div>
      <div class="title-area">
        <a href={BASE_URL} class="mag-title-link">
          <div class="mag-title-wrapper">
            <h1 class="mag-title">Dos Minutos Más</h1>
          </div>
        </a>
      </div>
    </div>

    <nav class="nav-links" aria-label="Navegación principal">
      <a href={`${BASE_URL}posts`}>Posts</a>
      <a href={`${BASE_URL}archive/2024`}>Archivo</a>
    </nav>

    <div class="toggle-area">
      <div class="toggle-track" id="themeToggle" role="switch" tabindex="0" aria-label="Cambiar a tema claro" aria-checked="false">
        <div class="toggle-thumb">
          <span class="toggle-icon-moon" aria-hidden="true">&#9790;</span>
          <span class="toggle-icon-sun" aria-hidden="true">&#9728;</span>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .mag-title-link {
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 20px;
    flex: 1;
    justify-content: center;
  }

  .nav-links a {
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
    letter-spacing: 0.01em;
  }

  .nav-links a:hover {
    color: var(--neon-purple);
  }

  @media (max-width: 768px) {
    .nav-links {
      order: 3;
      width: 100%;
      justify-content: center;
      gap: 24px;
      padding: 8px 0 4px;
    }
  }
</style>