---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostStandard from '../../components/PostStandard.astro';
import { getPostsByYear, getArchiveData } from '../../lib/supabase';

export async function getStaticPaths() {
  const archive = await getArchiveData();
  return archive.map((item) => ({
    params: { year: String(item.year) },
    props: { year: item.year },
  }));
}

const { year } = Astro.props;
const posts = await getPostsByYear(year);
---

<BaseLayout title={`Archivo ${year} — Dos Minutos Más`}>
  <Header slot="header" />

  <div class="container">
    <div class="archive-header">
      <h1>Archivo {year}</h1>
      <p>{posts.length} post{posts.length !== 1 ? 's' : ''}</p>
    </div>

    {posts.map((post) => (
      <PostStandard post={post} />
    ))}

    {posts.length === 0 && (
      <div class="empty-state">
        <p>No hay posts en {year} todavía.</p>
      </div>
    )}
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .archive-header {
    margin-bottom: 32px;
  }

  .archive-header h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 2rem;
    background: linear-gradient(135deg, var(--neon-purple), var(--neon-red));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 8px;
  }

  .archive-header p {
    color: var(--text-secondary);
    font-size: 0.85rem;
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-secondary);
  }
</style>
