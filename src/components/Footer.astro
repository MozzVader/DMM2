---
import { BASE_URL } from '../lib/constants';
---

<footer class="mag-footer">
  <p>Dos Minutos Más &copy; {new Date().getFullYear()} — Hecho con <span class="neon-word">humo</span> y mirrors. <a href={`${BASE_URL}rss.xml`} class="footer-rss" aria-label="Feed RSS"><svg class="rss-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="6.18" cy="17.82" r="2.18" fill="#FF8C00"/><path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z" fill="#FF8C00"/></svg>RSS</a></p>
</footer>

<style>
  .footer-rss {
    color: var(--text-secondary);
    text-decoration: none;
    margin-left: 8px;
    transition: color 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .footer-rss:hover {
    color: var(--neon-purple);
  }
  .footer-rss:hover .rss-icon circle,
  .footer-rss:hover .rss-icon path {
    fill: var(--neon-purple);
  }
  .rss-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
</style>