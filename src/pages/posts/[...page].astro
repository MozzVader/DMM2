---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostStandard from '../../components/PostStandard.astro';
import BottomGrid from '../../components/BottomGrid.astro';
import { getAllPostsForPagination } from '../../lib/supabase';

export async function getStaticPaths({ paginate }: any) {
  const allPosts = await getAllPostsForPagination();
  return paginate(allPosts, { pageSize: 10 });
}

const { page } = Astro.props;
---

<BaseLayout title={page.currentPage === 1 ? 'Todos los posts — Dos Minutos Más' : `Página ${page.currentPage} — Dos Minutos Más`}>
  <Header slot="header" />

  <div class="container">
    <div class="posts-header">
      <h1>Todos los posts</h1>
      <p>Página {page.currentPage} de {page.lastPage}</p>
    </div>

    {page.data.map((post: any) => (
      <PostStandard post={post} />
    ))}

    {page.data.length === 0 && (
      <div class="empty-state">
        <p>No hay posts todavía.</p>
      </div>
    )}

    <!-- Pagination -->
    {page.totalPages > 1 && (
      <nav class="pagination">
        <a
          href={page.urlPrev || '#'}
          class={`page-btn page-prev ${!page.urlPrev ? 'disabled' : ''}`}
          aria-disabled={!page.urlPrev}
        >
          ← Anterior
        </a>

        <div class="page-numbers">
          {Array.from({ length: page.totalPages }, (_, i) => i + 1).map((num) => (
            <a
              href={num === 1 ? import.meta.env.BASE_URL + 'posts' : import.meta.env.BASE_URL + 'posts/' + num}
              class={`page-num ${num === page.currentPage ? 'active' : ''}`}
            >
              {num}
            </a>
          ))}
        </div>

        <a
          href={page.urlNext || '#'}
          class={`page-btn page-next ${!page.urlNext ? 'disabled' : ''}`}
          aria-disabled={!page.urlNext}
        >
          Siguiente →
        </a>
      </nav>
    )}

    <BottomGrid />
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .posts-header {
    margin-bottom: 32px;
  }

  .posts-header h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 2rem;
    background: linear-gradient(135deg, var(--neon-purple), var(--neon-red));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 8px;
  }

  .posts-header p {
    color: var(--text-secondary);
    font-size: 0.85rem;
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-secondary);
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin: 40px 0 48px;
    flex-wrap: wrap;
  }

  .page-btn {
    padding: 8px 20px;
    border: 1px solid var(--border-subtle);
    border-radius: 5px;
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-family: 'Inter', sans-serif;
    transition: all 0.2s ease;
    background: var(--bg-card);
  }

  .page-btn:hover:not(.disabled) {
    border-color: var(--neon-purple);
    color: var(--neon-purple);
  }

  .page-btn.disabled {
    opacity: 0.3;
    pointer-events: none;
    cursor: default;
  }

  .page-numbers {
    display: flex;
    gap: 6px;
  }

  .page-num {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-subtle);
    border-radius: 5px;
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-family: 'Inter', sans-serif;
    transition: all 0.2s ease;
    background: var(--bg-card);
  }

  .page-num:hover {
    border-color: var(--neon-purple);
    color: var(--neon-purple);
  }

  .page-num.active {
    border-color: var(--neon-purple);
    background: rgba(191, 90, 242, 0.1);
    color: var(--neon-purple);
    font-weight: 600;
  }

  @media (max-width: 480px) {
    .pagination {
      gap: 8px;
    }

    .page-btn {
      padding: 6px 14px;
      font-size: 0.8rem;
    }
  }
</style>
