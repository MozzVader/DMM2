---
import type { Post } from '../lib/supabase';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;

const astroBase = (import.meta.env.BASE_URL || '/').replace(/\/$/, '') + '/';

const colors = ['purple', 'red', 'yellow', 'green'] as const;
---

<div class="mini-posts">
  {posts.map((post, i) => (
    <a href={`${astroBase}post/${post.slug}`} class="mini-post-item">
      <span class={`mini-dot ${colors[i % colors.length]}`}></span>
      <span class="mini-post-title">{post.title}</span>
      <span class="mini-post-date">
        {new Date(post.published_at).toLocaleDateString('es-AR', {
          day: 'numeric',
          month: 'short',
          year: 'numeric',
        })}
      </span>
    </a>
  ))}
</div>

<style>
  .mini-posts a {
    text-decoration: none;
  }
</style>
