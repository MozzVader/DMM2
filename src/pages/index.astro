---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionDivider from '../components/SectionDivider.astro';
import PostFeatured from '../components/PostFeatured.astro';
import PostStandard from '../components/PostStandard.astro';
import MiniPosts from '../components/MiniPosts.astro';
import BottomGrid from '../components/BottomGrid.astro';
import {
  getFeaturedPost,
  getAllPosts,
  type Post,
} from '../lib/supabase';

const featured = await getFeaturedPost();
const allPosts = await getAllPosts();

// Next 3 posts as horizontal cards
const standardPosts = allPosts.slice(0, 3);

// Remaining posts for the mini list
const miniPosts = allPosts.slice(3, 8);


---

<BaseLayout title="Dos Minutos Más">
  <Header slot="header" />

  <div class="container">

    <!-- Featured post -->
    {featured && <PostFeatured post={featured} />}

    <SectionDivider label="Más reciente" />

    <!-- Next 3 posts as horizontal cards -->
    {standardPosts.map((post) => (
      <PostStandard post={post} />
    ))}

    <SectionDivider label="Últimos posts" />

    <!-- Mini posts list -->
    {miniPosts.length > 0 && <MiniPosts posts={miniPosts} />}

    <SectionDivider label="Explorar" />

    <!-- Bottom grid -->
    <BottomGrid />

  </div>

  <Footer slot="footer" />
</BaseLayout>
