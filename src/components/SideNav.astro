---
import { BASE_URL } from '../lib/constants';
---

<nav class="side-nav" aria-label="Navegación">
  <a href={`${BASE_URL}about`} class="side-nav-link" style="--nav-color: #bf5af2; border-right-color: #bf5af2" title="About">
    <i class="material-icons" style="color: #bf5af2">person</i>
    <span>About</span>
  </a>
  <a href={`${BASE_URL}posts`} class="side-nav-link" style="--nav-color: #ff4757; border-right-color: #ff4757" title="Posts">
    <i class="material-icons" style="color: #ff4757">article</i>
    <span>Posts</span>
  </a>
  <a href={`${BASE_URL}archive`} class="side-nav-link" style="--nav-color: #ffd93d; border-right-color: #ffd93d" title="Archivo">
    <i class="material-icons" style="color: #ffd93d">archive</i>
    <span>Archivo</span>
  </a>
  <a href={`${BASE_URL}museo`} class="side-nav-link" style="--nav-color: #4ade80; border-right-color: #4ade80" title="Museo">
    <i class="material-icons" style="color: #4ade80">museum</i>
    <span>Museo</span>
  </a>
  <button class="side-nav-link" style="--nav-color: #22d3ee; border-right-color: #22d3ee" title="Random" id="randomPostBtn">
    <i class="material-icons" style="color: #22d3ee">shuffle</i>
    <span>Random</span>
  </button>
</nav>

<script is:inline>
document.getElementById('randomPostBtn').addEventListener('click', async () => {
  try {
    const base = document.querySelector('meta[property="og:url"]')?.content || '';
    const origin = base ? new URL(base).origin : location.origin;
    const basePath = new URL(origin).pathname.replace(/\/$/, '');
    const resp = await fetch(basePath + '/api/slugs.json');
    const posts = await resp.json();
    if (posts.length > 0) {
      const rand = posts[Math.floor(Math.random() * posts.length)];
      window.location.href = basePath + '/post/' + rand.slug;
    }
  } catch(e) {
    window.location.href = '/posts';
  }
});
</script>

<style>
  .side-nav {
    position: fixed;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 90;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .side-nav-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    width: 195px;
    transform: translateX(-190px);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                background-color 0.2s ease;
    background: var(--bg-card, #1a1a22);
    border: none;
    border-right: 5px solid var(--nav-color, #bf5af2);
    border-radius: 6px 0 0 6px;
    cursor: pointer;
    text-decoration: none;
    color: var(--text-secondary, #888);
    font-family: 'Inter', sans-serif;
    font-size: 0.88rem;
    font-weight: 500;
    white-space: nowrap;
    box-shadow: 2px 2px 10px rgba(0,0,0,0.4);
  }

  .side-nav-link i {
    font-size: 20px;
    width: 20px;
    text-align: center;
    flex-shrink: 0;
    color: var(--nav-color, #bf5af2);
  }

  .side-nav-link:hover {
    transform: translateX(0);
    color: var(--text-primary, #e8e8e8);
    background: rgba(255, 255, 255, 0.06);
  }

  /* Light mode */
  body.light .side-nav-link {
    background: rgba(245, 243, 240, 0.95);
    color: #666;
  }

  body.light .side-nav-link:hover {
    color: #1a1a1a;
    background: rgba(0, 0, 0, 0.05);
  }

  @media (max-width: 768px) {
    .side-nav-link {
      width: 170px;
      transform: translateX(-165px);
      padding: 8px 12px;
      font-size: 0.82rem;
    }
  }
</style>