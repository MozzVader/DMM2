---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BottomGrid from '../../components/BottomGrid.astro';
import { getAllPosts, getFeaturedPost } from '../../lib/supabase';
import { BASE_URL, AUTHOR } from '../../lib/constants';
import { sanitizeHTML, formatDate, stripHTML, readingTime } from '../../lib/utils';
import type { Post } from '../../lib/supabase';

export async function getStaticPaths() {
  const [regularPosts, featuredPost] = await Promise.all([
    getAllPosts(),
    getFeaturedPost(),
  ]);

  const allPosts: Post[] = featuredPost
    ? [featuredPost, ...regularPosts]
    : regularPosts;

  return allPosts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      prevPost: index < allPosts.length - 1 ? allPosts[index + 1] : null,
      nextPost: index > 0 ? allPosts[index - 1] : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;

const dateStr = formatDate(post.published_at);
const safeContent = sanitizeHTML(post.content);
const metaDescription = post.excerpt || stripHTML(post.content).slice(0, 160);
const mins = readingTime(post.content);

const supabaseUrl = import.meta.env.SUPABASE_URL || '';
const supabaseAnonKey = import.meta.env.SUPABASE_ANON_KEY || '';
---

<BaseLayout title={`${post.title} — Dos Minutos Más`} description={metaDescription} ogImage={post.featured_image || undefined} ogType="article">
  <Header slot="header" />

  <div class="container">
    <article class="post-single">
      <div class="post-single-image">
        {post.featured_image && (
          <img src={post.featured_image} alt={post.title} loading="lazy" width="1200" height="420" />
        )}
      </div>

      <div class="post-single-body">
        <span class={`post-badge badge-${post.badge_color || 'purple'}`}>{post.badge || 'General'}</span>
        <h1 class="post-single-title">{post.title}</h1>
        <div class="post-meta">
          <span class="meta-item"><svg class="meta-icon" aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>{dateStr}</span>
          <span class="dot-sep"></span>
          <span class="meta-item"><svg class="meta-icon" aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>{AUTHOR.name}</span>
          <span class="dot-sep"></span>
          <span class="meta-item"><svg class="meta-icon" aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>{mins} min de lectura</span>
        </div>

        <div class="post-content" set:html={safeContent} />

        <!-- Post footer: tags, likes, share -->
        <div class="post-footer">
          <div class="post-footer-tags">
            {post.tags && post.tags.length > 0 && post.tags.map((tag) => (
              <a href={`${BASE_URL}tag/${tag.slug}`} class="tag-pill" style="border-color: rgba(191, 90, 242, 0.2); color: rgba(191, 90, 242, 0.8);">
                {tag.name}
              </a>
            ))}
          </div>

          <div class="post-footer-like">
            <button class="like-btn" id="likeBtn" aria-label="Me gusta" data-post-id={post.id} data-sb-url={supabaseUrl} data-sb-key={supabaseAnonKey}>
              <span class="like-icon" id="likeIcon" aria-hidden="true">&#9829;</span>
              <span class="like-count" id="likeCount">{(post.likes || 0)}</span>
            </button>
          </div>

          <div class="post-footer-share">
            <a class="share-btn share-facebook" href="#" id="shareFb" aria-label="Compartir en Facebook" target="_blank" rel="noopener">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a class="share-btn share-twitter" href="#" id="shareTw" aria-label="Compartir en X" target="_blank" rel="noopener">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <a class="share-btn share-whatsapp" href="#" id="shareWa" aria-label="Compartir en WhatsApp" target="_blank" rel="noopener">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </a>
            <button class="share-btn share-copy" id="shareCopy" aria-label="Copiar link">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
            </button>
          </div>
        </div>
      </div>
    </article>

    {(prevPost || nextPost) && (
      <nav class="post-nav" aria-label="Navegación entre posts">
        {prevPost && (
          <a href={`${BASE_URL}post/${prevPost.slug}`} class="post-nav-link post-nav-prev">
            <span class="post-nav-label">← Anterior</span>
            <span class="post-nav-title">{prevPost.title}</span>
          </a>
        )}
        {nextPost && (
          <a href={`${BASE_URL}post/${nextPost.slug}`} class="post-nav-link post-nav-next">
            <span class="post-nav-label">Siguiente →</span>
            <span class="post-nav-title">{nextPost.title}</span>
          </a>
        )}
      </nav>
    )}

    <BottomGrid />
  </div>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  (function() {
    var likeBtn = document.getElementById('likeBtn');
    var likeCount = document.getElementById('likeCount');
    var postId = likeBtn.getAttribute('data-post-id');
    var sbUrl = likeBtn.getAttribute('data-sb-url');
    var sbKey = likeBtn.getAttribute('data-sb-key');
    var currentLikes = parseInt(likeCount.textContent, 10);

    var likedPosts = JSON.parse(localStorage.getItem('dmm_liked') || '[]');
    if (likedPosts.indexOf(postId) !== -1) {
      likeBtn.classList.add('liked');
    }

    likeBtn.addEventListener('click', async function() {
      if (likedPosts.indexOf(postId) !== -1) return;

      try {
        var resp = await fetch(sbUrl + '/rest/v1/rpc/increment_likes', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'apikey': sbKey,
            'Authorization': 'Bearer ' + sbKey
          },
          body: JSON.stringify({ post_id: postId })
        });
        if (resp.ok) {
          likedPosts.push(postId);
          localStorage.setItem('dmm_liked', JSON.stringify(likedPosts));
          likeBtn.classList.add('liked');
          currentLikes++;
          likeCount.textContent = currentLikes;
        }
      } catch(e) {
        // Network error — do NOT save to localStorage or increment count
        // so the user can retry when connectivity returns
        likeBtn.style.transform = 'scale(1.2)';
        setTimeout(function() { likeBtn.style.transform = ''; }, 300);
      }
    });

    var pageUrl = window.location.href;
    var pageTitle = document.title;

    document.getElementById('shareFb').href = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(pageUrl);
    document.getElementById('shareTw').href = 'https://x.com/intent/tweet?url=' + encodeURIComponent(pageUrl) + '&text=' + encodeURIComponent(pageTitle);
    document.getElementById('shareWa').href = 'https://api.whatsapp.com/send?text=' + encodeURIComponent(pageTitle + ' ' + pageUrl);

    document.getElementById('shareCopy').addEventListener('click', function() {
      navigator.clipboard.writeText(pageUrl).then(function() {
        var btn = document.getElementById('shareCopy');
        btn.classList.add('copied');
        setTimeout(function() { btn.classList.remove('copied'); }, 1500);
      });
    });
  })();
</script>

<style>
  .post-single {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 5px;
    overflow: hidden;
    margin-bottom: 32px;
    border-top: 2px solid var(--neon-purple);
    box-shadow: var(--shadow-card);
  }

  .post-single-image {
    width: 100%;
    height: 420px;
    overflow: hidden;
    background: linear-gradient(135deg, #1a1a2e, #2d1b4e, #1a1a2e);
    aspect-ratio: 1200 / 420;
  }

  .post-single-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .post-single-body {
    padding: 36px 40px 48px;
  }

  .post-single-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    line-height: 1.2;
    color: var(--text-primary);
    margin-bottom: 16px;
    letter-spacing: -0.01em;
  }

  .post-content {
    font-size: 15px;
    line-height: 1.85;
    color: var(--text-body);
    margin-top: 24px;
  }

  .post-content :global(h2),
  .post-content :global(h3) {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    color: var(--text-primary);
    margin: 32px 0 12px;
  }

  .post-content :global(h2) { font-size: 1.4rem; }
  .post-content :global(h3) { font-size: 1.15rem; }

  .post-content :global(p) {
    margin-bottom: 16px;
  }

  .post-content :global(a) {
    color: var(--neon-purple);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .post-content :global(a:hover) {
    color: var(--neon-red);
  }

  .post-content :global(small a),
  .post-content :global(a small) {
    color: var(--neon-purple);
  }

  .post-content :global(small a:hover),
  .post-content :global(a small:hover) {
    color: var(--neon-red);
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--neon-purple);
    padding-left: 16px;
    margin: 20px 0;
    color: var(--text-secondary);
    font-style: italic;
    overflow: hidden;
  }

  .post-content :global(code) {
    background: var(--bg-input);
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 0.9em;
  }

  .post-content :global(pre) {
    background: var(--bg-input);
    padding: 16px;
    border-radius: 5px;
    overflow-x: auto;
    margin: 16px 0;
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
  }

  .post-content :global(img) {
    max-width: 100%;
    border-radius: 5px;
    margin: 16px 0;
  }

  .post-content :global(small) {
    font-size: 0.8em;
    color: var(--text-secondary);
  }

  .post-content :global(.ql-bright) {
    color: #ffffff !important;
  }

  /* Post footer: tags + likes + share */
  .post-footer {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .post-footer-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    flex: 1;
  }

  .post-footer-tags a {
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .post-footer-tags a:hover {
    transform: translateY(-1px);
  }

  .post-footer-like {
    flex-shrink: 0;
  }

  .like-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    padding: 6px 14px;
    cursor: pointer;
    transition: all 0.2s ease;
    color: var(--text-secondary);
  }

  .like-btn:hover {
    border-color: var(--neon-red);
    color: var(--neon-red);
  }

  .like-btn.liked {
    border-color: var(--neon-red);
    color: var(--neon-red);
  }

  .like-btn.liked .like-icon {
    animation: heartPulse 0.3s ease;
  }

  @keyframes heartPulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.3); }
    100% { transform: scale(1); }
  }

  .like-icon {
    font-size: 1.1rem;
    line-height: 1;
  }

  .like-btn.liked .like-icon {
    color: var(--neon-red);
  }

  .like-count {
    font-size: 0.85rem;
    font-family: 'Inter', sans-serif;
    font-weight: 500;
  }

  .post-footer-share {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  .share-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .share-btn:hover {
    transform: translateY(-1px);
  }

  .share-facebook:hover {
    border-color: #1877f2;
    color: #1877f2;
  }

  .share-twitter:hover {
    border-color: #fff;
    color: #fff;
  }

  .share-whatsapp:hover {
    border-color: #25d366;
    color: #25d366;
  }

  .share-copy {
    cursor: pointer;
    background: transparent;
  }

  .share-copy:hover {
    border-color: var(--neon-purple);
    color: var(--neon-purple);
  }

  .share-copy.copied {
    border-color: var(--neon-green);
    color: var(--neon-green);
  }

  /* Post navigation */
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 40px;
  }

  .post-nav-link {
    padding: 20px 24px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 5px;
    text-decoration: none;
    transition: border-color 0.2s ease;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .post-nav-link:hover {
    border-color: var(--neon-purple);
  }

  .post-nav-prev {
    text-align: left;
  }

  .post-nav-next {
    text-align: right;
  }

  .post-nav-label {
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-family: 'Inter', sans-serif;
  }

  .post-nav-title {
    font-size: 0.95rem;
    color: var(--text-primary);
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-nav-link:hover .post-nav-title {
    color: var(--neon-purple);
  }

  @media (max-width: 768px) {
    .post-single-body {
      padding: 24px 22px 32px;
    }

    .post-single-image {
      height: 260px;
    }

    .post-footer {
      flex-wrap: wrap;
    }

    .post-footer-tags {
      order: 1;
      flex-basis: 100%;
    }

    .post-footer-like {
      order: 2;
    }

    .post-footer-share {
      order: 3;
    }

    .post-nav {
      grid-template-columns: 1fr;
    }

    .post-nav-next {
      text-align: left;
    }
  }

  @media (max-width: 480px) {
    .post-single-body {
      padding: 20px 18px 28px;
    }

    .post-single-image {
      height: 200px;
    }
  }
</style>