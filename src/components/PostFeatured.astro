---
import type { Post } from '../lib/supabase';

interface Props {
  post: Post;
}

const { post } = Astro.props;

const dateStr = new Date(post.published_at).toLocaleDateString('es-AR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const astroBase = (import.meta.env.BASE_URL || '/').replace(/\/$/, '') + '/';
const link = `${astroBase}post/${post.slug}`;
const stripHTML = (html: string) => html.replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').trim();
const excerpt = post.excerpt || (post.content ? stripHTML(post.content).slice(0, 200) + '...' : '');
---

<a href={link} class="post-featured-link">
  <article class="post-featured">
    {post.featured_image ? (
      <div class="featured-image-wrap has-image">
        <img src={post.featured_image} alt={post.title} loading="lazy" />
        <span class="edge-glow"></span>
        <div class="featured-overlay"></div>
        <div class="featured-body">
          <span class={`post-badge badge-${post.badge_color || 'purple'}`}>{post.badge || 'Destacado'}</span>
          <h2>{post.title}</h2>
          <div class="post-meta">
            <span class="meta-item"><svg class="meta-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>{dateStr}</span>
            <span class="dot-sep"></span>
            <span class="meta-item"><svg class="meta-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>Mozz</span>
          </div>
          <p class="post-excerpt">{excerpt}</p>
          <span class="read-more">
            Leer más <span class="arrow">→</span>
          </span>
        </div>
      </div>
    ) : (
      <div class="featured-image-wrap">
        <span class="edge-glow"></span>
        <div class="featured-body">
          <span class={`post-badge badge-${post.badge_color || 'purple'}`}>{post.badge || 'Destacado'}</span>
          <h2>{post.title}</h2>
          <div class="post-meta">
            <span class="meta-item"><svg class="meta-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>{dateStr}</span>
            <span class="dot-sep"></span>
            <span class="meta-item"><svg class="meta-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>Mozz</span>
          </div>
          <p class="post-excerpt">{excerpt}</p>
          <span class="read-more">
            Leer más <span class="arrow">→</span>
          </span>
        </div>
      </div>
    )}
  </article>
</a>

<style>
  .post-featured-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .post-featured-link:hover .post-featured {
    border-color: var(--neon-purple);
    box-shadow: 0 0 20px rgba(168, 85, 247, 0.1);
  }

  .post-featured-link:hover h2 {
    color: var(--neon-purple);
  }

  .post-featured {
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  /* When there's no image, body text stays dark (default theme colors) */
  .featured-image-wrap:not(.has-image) .featured-body h2 {
    color: var(--text-primary);
    transition: color 0.2s ease;
  }

  .featured-image-wrap:not(.has-image) .featured-body .post-meta {
    color: var(--text-secondary);
  }

  .featured-image-wrap:not(.has-image) .featured-body .post-excerpt {
    color: var(--text-body);
  }

  .featured-image-wrap:not(.has-image) .featured-body .meta-icon {
    opacity: 0.5;
  }

  .featured-image-wrap:not(.has-image) .featured-body .dot-sep {
    background: var(--text-secondary);
  }

  .featured-image-wrap:not(.has-image) .featured-body .read-more {
    color: var(--text-secondary);
  }
</style>
