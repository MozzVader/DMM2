---
import { BASE_URL } from '../lib/constants';
---

<footer class="mag-footer">
  <p>Dos Minutos Más &copy; {new Date().getFullYear()} — Hecho con <span class="neon-word">humo</span> y mirrors. <a href="https://cafecito.app/mozz_vader" class="footer-link" target="_blank" rel="noopener" aria-label="Invitame un cafecito"><svg class="footer-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 21V19H20V21H2ZM20 8V5H22V8C22 9.1 21.55 10.08 20.65 10.94C19.75 11.8 18.66 12.23 17.38 12.23V10.23C18.14 10.23 18.83 9.94 19.44 9.35C20.05 8.76 20.33 8.03 20.33 7.15V8H20ZM4 17V15C4.83 15 5.54 14.71 6.14 14.12C6.74 13.53 7.04 12.8 7.04 11.92V4H9.04V11.92C9.04 13.33 8.52 14.52 7.48 15.47C6.44 16.42 5.26 16.9 3.96 16.9L4 17Z" fill="currentColor"/></svg></a><a href={`${BASE_URL}rss.xml`} class="footer-link" aria-label="Feed RSS"><svg class="footer-icon rss-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="6.18" cy="17.82" r="2.18" fill="#FF8C00"/><path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z" fill="#FF8C00"/></svg></a></p>
</footer>

<style>
  .footer-link {
    color: var(--text-secondary);
    text-decoration: none;
    margin-left: 8px;
    transition: color 0.2s ease;
    display: inline-flex;
    align-items: center;
  }
  .footer-link:hover {
    color: var(--neon-purple);
  }
  .footer-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  /* RSS keeps its orange color */
  .rss-icon circle,
  .rss-icon path {
    fill: #FF8C00;
  }
  .footer-link:hover .rss-icon circle,
  .footer-link:hover .rss-icon path {
    fill: var(--neon-purple);
  }
</style>