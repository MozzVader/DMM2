---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { BASE_URL } from '../lib/constants';
---

<BaseLayout title="Página no encontrada — 404">
  <Header slot="header" />
  <div class="error-page">
    <div class="error-404">404</div>
    <h1>Esta página se ha mudado o no existe</h1>
    <p>Parece que el enlace que seguiste está roto o el post cambió de dirección durante el revamp.</p>
    <a href={BASE_URL} class="error-btn">Volver al Inicio</a>
  </div>
  <Footer slot="footer" />
</BaseLayout>

<style>
  .error-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    text-align: center;
    padding: 2rem;
  }

  .error-404 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 8.1rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, var(--neon-purple) 0%, var(--neon-red) 50%, var(--neon-yellow) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .error-page h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .error-page p {
    font-size: 1.2rem;
    max-width: 500px;
    margin-bottom: 2rem;
    color: var(--text-secondary);
  }

  .error-btn {
    display: inline-block;
    padding: 0.8rem 1.5rem;
    background: var(--neon-purple);
    color: #fff;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-family: 'Space Grotesk', sans-serif;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .error-btn:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }
</style>