---
import type { Post } from '../lib/supabase';

interface Props {
  post: Post;
}

const { post } = Astro.props;

const dateStr = new Date(post.published_at).toLocaleDateString('es-AR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const astroBase = (import.meta.env.BASE_URL || '/').replace(/\/$/, '') + '/';
const link = `${astroBase}post/${post.slug}`;
const excerpt = post.excerpt || (post.content ? post.content.slice(0, 160) + '...' : '');
---

<article class="post-standard">
  {post.featured_image ? (
    <div class="standard-image" style={`background-image: url(${post.featured_image}); background-size: cover; background-position: center;`}></div>
  ) : (
    <div class="standard-image"></div>
  )}
  <div class="standard-body">
    <span class={`post-badge badge-${post.badge_color || 'red'}`}>{post.badge || 'General'}</span>
    <h3><a href={link}>{post.title}</a></h3>
    <div class="post-meta">
      <span>{dateStr}</span>
      <span class="dot-sep"></span>
      <span>Mozz</span>
    </div>
    <p class="post-excerpt">{excerpt}</p>
    <a href={link} class="read-more" style="margin-top: 8px;">
      Leer más <span class="arrow">→</span>
    </a>
  </div>
</article>

<style>
  .standard-body h3 a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .standard-body h3 a:hover {
    color: var(--neon-purple);
  }
</style>
